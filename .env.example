# =============================================================================
# Talentus Pro Tracking - plantilla de .env
# -----------------------------------------------------------------------------
# Copiar a .env y completar. Las lineas SIN comentar son las que hay que
# revisar en cada instalacion. Las comentadas muestran el valor por defecto del
# codigo: descomentar solo para cambiarlo.
#
# Los booleanos van como true / false. Tras editar el .env en un servidor que
# usa cache de configuracion: php artisan config:cache
#
# Correo (SMTP, SendGrid...), SMS, claves de mapas, UNIGIS y Securitas NO van
# aqui: se configuran desde el panel de administracion (base de datos).
# =============================================================================


# ----------------------------------------------------------------------------
# Aplicacion
# ----------------------------------------------------------------------------
APP_KEY=
APP_URL=http://localhost
APP_DEBUG=false
# Si no se define, la aplicacion asume «production» (tambien en desarrollo).
# APP_ENV=production
# APP_NAME=laravel

# Tipo de instalacion y clave de licencia de la base GPSWOX
APP_TYPE=ss3
key=
server=localhost

# FORCE_HTTPS=false
# TRUST_HOSTS=
# LOGIN_REDIRECT_ROUTE=
# FRONTEND_PASSWORD=
# BCRYPT_ROUNDS=10
# FLOATING_IP=

# Remitente por defecto (el transporte de correo se configura en el admin)
# email_from=noreply@noname.com
# email_name="GPS Tracker"
# EMAIL_DOMAIN=example.com


# ----------------------------------------------------------------------------
# Base de datos
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Base web (usuarios, dispositivos, geocercas...)
web_database=gpswox_web
# Por defecto usan DB_USERNAME / DB_PASSWORD
# web_username=
# web_password=

# Base de Traccar (posiciones: una tabla por dispositivo)
traccar_database=gpswox_traccar
# traccar_username=
# traccar_password=

# DB_FOREIGN_KEYS=true
# Conexion para el registro de cambios (tabla model_change_logs). Vacio = la principal.
# ACTIVITY_LOGGER_DB_CONNECTION=
# ACTIVITY_LOGGER_ENABLED=true


# ----------------------------------------------------------------------------
# Redis, cache, sesiones y colas
# ----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=1
# REDIS_CLIENT=predis
# REDIS_PREFIX=

# Conexion «process»: ingesta de posiciones, cerrojos de insert:run, espectadores de video
# REDIS_PROCESS_HOST=127.0.0.1
# REDIS_PROCESS_PORT=6379
# REDIS_PROCESS_PASSWORD=
# REDIS_PROCESS_DB=0

# REDIS_SESSION_HOST=127.0.0.1
# REDIS_SESSION_PORT=6379
# REDIS_SESSION_PASSWORD=
# REDIS_SESSION_DB=2

# REDIS_CACHE_HOST=127.0.0.1
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_PASSWORD=
# REDIS_CACHE_DB=3

# CACHE_DRIVER=redis
# QUEUE_DRIVER=redis
# QUEUE_FAILED_DRIVER=database-uuids
# BROADCAST_DRIVER=redis
# SESSION_DRIVER=redis
# SESSION_CONNECTION=session
# SESSION_LIFETIME=525600
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_REMEMBER_ME=true
# SESSION_SECURE_COOKIE=


# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
LOG_CHANNEL=daily
# REQUEST_LOGS=false
# POSITIONS_IP_LOG=false
# PAYMENTS_ERROR_LOG=false
# FUEL_CHECK_LOCK_LOG=false
# CHECK_SERVICE_EXPIRE_LOG=false
# LOG_SEND_MAIL_TEMPLATE=false
# FALLBACK_SEND_MAIL_TEMPLATE=true
# WEBHOOK_LOG=false
# WEBHOOK_RETRY=0
# WEBHOOK_TIMEOUT=5
# BUGSNAG_API_KEY=
# BUGSNAG_NOTIFY_RELEASE_STAGES=


# ----------------------------------------------------------------------------
# Tracker (Traccar) y servidor de sockets
# ----------------------------------------------------------------------------
# Clave de administracion del tracker (Basic admin:<valor>) para comandos y video
admin_user=admin
# Por defecto, APP_URL
TRACKER_WEB_URL=http://localhost
# TRACKER_WEB_PORT=8082
# logs_path=/opt/traccar/logs
# media_path=/var/www/html/requestPhoto/
# TRACKER_CONFIG_READONLY=false
# DEVICE_CONFIGURATION_DELAY=5

# NO definir SOCKET_PORT ni SOCKET_SSL_PORT con otros valores: socket/socket.js
# los leeria, pero el navegador (legacy y UI v2) conecta siempre a 9001 / 9002.
# SOCKET_PORT=9001
# SOCKET_SSL_PORT=9002


# ----------------------------------------------------------------------------
# Ingesta de posiciones (insert:run / PositionsWriter)
# ----------------------------------------------------------------------------
# Guarda mcc/mnc/lac/cellid/operator en los parametros de cada posicion.
# El codigo trae true por defecto; false conserva el comportamiento anterior.
APPLY_NETWORK_DATA=false

# PROC_INSERT_TIMEOUT=60
# PROC_INSERT_LIMIT=30
# MAX_SPEED_LIMIT=300
# MIN_TIME_GAP=600
# OVERWRITE_INVALID=true
# PREV_POSITION_DEVICE_OBJECT=false

# Filtro de saltos GNSS. Por defecto solo marca la posicion (gnss_glitch) y
# escribe storage/logs/validaciones_tecnicas-*.log. Con ENFORCE=true ademas
# invalida la posicion: no suma km ni dispara alertas.
# GNSS_GLITCH_ENABLED=true
# GNSS_GLITCH_ENFORCE=false
# GNSS_GLITCH_MAX_AGE=30
# GNSS_GLITCH_ALT_MIN_JUMP=40
# GNSS_GLITCH_ALT_MAX_RATE=20
# GNSS_GLITCH_ALT_STATIONARY_SPEED=3
# GNSS_GLITCH_ALT_STATIONARY_DIST=10
# GNSS_GLITCH_ACCEL_MAX=10
# GNSS_GLITCH_ACCEL_MIN_SPEED=25
# GNSS_GLITCH_ACCEL_CORROBORATION_PCT=0.35
# GNSS_GLITCH_TELE_MIN_DIST=50
# GNSS_GLITCH_TELE_FACTOR=2
# GNSS_GLITCH_TELE_MARGIN=40

# Salto al arrancar desde parada
# FROM_STOP_MAX_JUMP_METERS=150
# FROM_STOP_AVG_SPEED_MULTIPLIER=1.3
# FROM_STOP_AVG_SPEED_MARGIN_KPH=5

# Exceso de velocidad en geocerca. MAX_GAP afecta a las alertas: reinicia el
# cronometro del exceso si pasan mas segundos sin tramas.
# OVERSPEED_TRACKING_MAX_GAP=300
# NATIVE_GEOFENCE_SPEED_ENABLED=true


# ----------------------------------------------------------------------------
# Modulos (apagados no consultan nada)
# ----------------------------------------------------------------------------
# Operaciones: control de vueltas y reporte de turno
OPERATIONS_ENABLED=false
# Seguridad: control de flota
SECURITY_ENABLED=false


# ----------------------------------------------------------------------------
# Backups
# ----------------------------------------------------------------------------
# Ruta del rclone.conf. Solo para copias en Google Drive (docs/backups-google-drive.md)
# BACKUP_RCLONE_CONFIG=/etc/rclone-backups/rclone.conf


# ----------------------------------------------------------------------------
# Video JT1078 (docs/video/GUIA-DESPLIEGUE.md). Exige el fork de Traccar.
# ----------------------------------------------------------------------------
# Sin URL y secreto solo hay modo compatible (HLS): no hay tiempo real, audio ni Hablar.
# El secreto debe ser igual a media.streamSecret de traccar.xml.
# VIDEO_STREAM_URL=https://TU-DOMINIO/tracker-media/stream/live
# VIDEO_STREAM_SECRET=
# VIDEO_STREAM_TOKEN_TTL=600
# VIDEO_PROTOCOLS=jt808

# VIDEO_G726_PACKING=rfc3551
# VIDEO_TALK_CHANNEL=36
# VIDEO_TALK_HISILICON_HEADER=true
# VIDEO_TALK_G726_BITS=5

# VIDEO_DOWNLOADS_DISK=local
# VIDEO_DOWNLOADS_DAYS=7
# VIDEO_DOWNLOADS_QUEUE=video
# VIDEO_FFMPEG=ffmpeg

# Subida nativa por FTP (opcional). Los valores los imprime: php artisan video:ftp-user
# VIDEO_FTP_ENABLED=false
# VIDEO_FTP_HOST=
# VIDEO_FTP_PORT=21
# VIDEO_FTP_USERNAME=videoupload
# VIDEO_FTP_PASSWORD=
# VIDEO_FTP_ROOT=
# VIDEO_FTP_TIMEOUT=60

# Conversion de videos h265 de dualcam
# DUALCAM=true


# ----------------------------------------------------------------------------
# Talentus IA CHAT
# ----------------------------------------------------------------------------
# Clave, modelos, cuotas y tope se ponen mejor en Admin > Configuracion >
# Talentus IA CHAT (la clave queda cifrada y prevalece sobre el .env).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2026-10-21
# AI_ENABLED=true
# AI_MODEL=claude-sonnet-5-5
# AI_LIGHT_MODEL=claude-haiku-5-5
# AI_EFFORT=medium
# AI_MAX_TOKENS=16000
# AI_TIMEOUT=180
# AI_FALLBACKS=true
# AI_PREFIX_CACHE_TTL=1h
# AI_MAX_RANGE_DAYS=31
# AI_MAX_DEVICES=100
# AI_EXPLAIN_REPORT=true
# AI_REPORT_EMAIL=true
# AI_DASHBOARD=true
# Resumen diario de alertas a las 07:00. Escribe a los clientes.
# AI_ALERTS_DIGEST=false
# AI_MONTHLY_QUESTIONS=100
# Tope de gasto mensual en USD (0 = sin tope)
# AI_MONTHLY_BUDGET_USD=0


# ----------------------------------------------------------------------------
# Seguridad de acceso
# ----------------------------------------------------------------------------
# 2FA. Encendido, TODO usuario web sin 2FA es enviado a configurarlo.
# OTP_ENABLED=false
# OTP_LIFETIME=0
# OTP_KEEP_ALIVE=true
# OTP_SKIP_ON_LOGIN_AS=true
# OTP_THROW_EXCEPTION=true

# ENABLE_SECONDARY_CREDENTIALS=
# LOGIN_PERIODS=false
# VERIFICATION_AUTOLOGIN=false
# VERIFICATION_REDIRECT=
# THROTTLE_API_LOGIN=60,1
# THROTTLE_WEB_LOGIN=60,1
# THROTTLE_WEB_PASSWORD_RESET=60,1

# Azure AD (SSO)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_RESOURCE=
# AZURE_DOMAIN_HINT=
# AZURE_SCOPE=User.Read


# ----------------------------------------------------------------------------
# Integraciones
# ----------------------------------------------------------------------------
# ERP Talentus. Con TALENTUS_URL vacio el webhook no sale (usar asi en desarrollo).
TALENTUS_URL=
TALENTUS_EMPRESA_ID=
TALENTUS_API_KEY=

# URL_COMSATEL_PROD=
# URL_MININTER_BETA=
# URL_MININTER_PROD=

# Google: geocodificacion, snap to road y velocidad maxima de via
# google_api_key=
# snaptoroad_key=
# speedlimit_key=
# streetview_default=0

# Push (FCM)
# FCM_SENDER_ID=
# FCM_CHANNEL_ID=
# FCM_SOUND=default

# SMS_CURL_TIMEOUT=5
# GEOCODER_CACHE_DRIVER=sqlite
# WKHTMLTOPDF_BINARY=


# ----------------------------------------------------------------------------
# Limites y rendimiento
# ----------------------------------------------------------------------------
# limit=
# OBJECT_MEMORY_LIMIT=4096M
# REPORT_MEMORY_LIMIT=8192M
# ENTITY_LOADER_PAGE_LIMIT=100
# MAX_HISTORY_PERIOD_DAYS=31
# HISTORY_SHOW_INVALID=true

# PROC_REPORT_TIMEOUT=180
# PROC_REPORT_LIMIT=2
# PROC_SEND_EVENT_TIMEOUT=120
# PROC_SEND_EVENT_LIMIT=2
# PROC_SEND_EVENT_TAKE=50

# LIMIT_ALERT_PHONES=5
# LIMIT_ALERT_EMAILS=5
# LIMIT_ALERT_WEBHOOKS=2
# LIMIT_GEOFENCE_GROUPS=50
# LIMIT_REPORT_EMAILS=5
# LIMIT_COMMAND_DEVICES=10
# LIMIT_COMMAND_GPRS_DEVICES=0
# LIMIT_FORWARD_IPS=5

# Frecuencia de sondeo del navegador, en segundos
# APP_CHECK_FREQUENCY=5
# APP_CHECK_CHAT_FREQUENCY=5
# APP_CHECK_CHAT_UNREAD_FREQUENCY=60

# POSITION_RESULT_NOTIFICATION=user
# ALERTS_THROW_USER_DEVICE=true
# DEVICE_SIDEBAR_QUERY=true
# ENTITYLOADER_STORE_QUERY=false
# REGEX_PHONE="/^\+?\d[0-9]{7,15}$/"


# ----------------------------------------------------------------------------
# Addons (config/addon.php). Activan o esconden funciones de la interfaz.
# ----------------------------------------------------------------------------
# SERVICE_CHECKLISTS=false
# WIDGET_TEMPLATE_WEBHOOK=
# bulk_objects_delete=false
# object_delete_pass=
# ENABLE_CUSTOM_FIELDS=true
# ENABLE_CUSTOM_FIELDS_TASK=true
# SHOW_POPUPS=false
# google_styled=false
# NEGATIVE_DEVICE_SERVICE=false
# ENABLE_CUSTOM_DEVICE_ADD=false
# ENABLE_DEVICE_TYPE=false
# HTML_GEOLOCATION=false
# ALERT_TIME_DURATION=false
# ALERT_MOVE_START_FILTERED=true
# ENGINE_HOURS_CURRENT_REPORT=true
# GENERAL_INFORMATION_6_REPORT=false
# DEVICE_APP_SINGLE_USAGE=false
# ENABLE_MEDIA_CATEGORIES=false
# ENABLE_TRACKER_APP_LOGIN=false
# ENABLE_EXTERNAL_URL=false
# ENABLE_LOGIN_TOKEN=false
# REPORT_FUEL_TANK_USAGE=false
# REPORTS_GEOFLEET_IN=false
# ENABLE_BEACONS=true
# ENABLE_FORWARDS=false
# ENABLE_FORWARD_CUSTOM=false
# ENABLE_FORWARD_PEGASUS=false
# ENABLE_FORWARD_MACROPOINT=false
# ENABLE_DEVICE_AUTHENTICATION_FIELD=false
# ENABLE_SENSOR_TYPE_ANONYMIZER=false
# ENABLE_SENSOR_PLUGGED=false
# ENABLE_ONE_SESSION_PER_USER=false
# ENABLE_INACCURACY=false
# ENABLE_PLAN_TEMPLATES=false
# ENABLE_DEVICE_MODELS=false
# ENABLE_REPORT_SEND_TO_FTP=false
# ENABLE_LBS=false
# ENABLE_CUSTOM_OVERLAYS_MAP=false
# TMP_OBJECT_FILTER=false
# ENABLE_DEVICES_ALL=false
# TMP_FUEL_STRATEGY_PEAKS=true
# ENABLE_UNTOUCHABLE_ACCESSIBLE=false
# ENABLE_SENSOR_POSITION_ALL=false
# ENABLE_STREET_VIEW_FRAME=true
# ENABLE_DISTANCE_POINT=false
# ENABLE_DEVICE_CUSTOM_DATA=false
# DISTANCE_CALC_STRATEGY=false
# ENABLE_FLIGHTS_INFO=false
# ENABLE_TAGS=true
